{
  "name": "listing-clone",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "icons": "python3 scripts/gen-icons.py",
    "measure": "node scripts/measure.mjs",
    "a11y": "node scripts/a11y-check.mjs",
    "verify": "npm run build && npm run measure && npm run a11y"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "playwright": "^1.63.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
